# Secrets for the staging stack (docker-compose.staging.yml). Copy to
# .env.staging, which is gitignored.
#
# The GitHub OAuth credentials are deliberately NOT here: they belong to the
# shared edge in ../staging-infra/.env, because one login covers every staging
# app rather than each app owning its own.

DEEPSEEK_API_KEY=sk-...

# Optional. REDIS_URL is set by the compose file; overriding it here is how you
# would accidentally put staging conversations in the dev Redis.
# LOG_LEVEL=INFO
# CLIMATE_OUT_DIR=/app/data

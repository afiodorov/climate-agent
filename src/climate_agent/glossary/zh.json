        "最长不适连续期",
        "糟糕连续期",
        "最长坏天气期",
        "最长难熬期"
      ],
      "definition": "在 {start_year}–{end_year} 记录中，舒适小时不足一小时的连续天数的最长一段。连续期很长，意味着那是一个只能熬过去的季节。"
    },
    "air-quality factor": {
      "term": "空气质量因子",
      "aliases": [
        "空气质量因子",
        "空气质量系数",
        "空气质量乘数",
        "空气质量惩罚",
        "空气质量折扣",
        "空气质量因素",
        "空气因子"
      ],
      "definition": "对污染空气的惩罚，从 1（空气清洁，无惩罚）向下直至 0.25 的下限，根据该城市细颗粒物的平均水平计算得出。"
    },
    "PM2.5": {
      "term": "细颗粒物",
      "aliases": [
        "细颗粒物",
        "细微颗粒物",
        "可入肺颗粒物",
        "PM2.5浓度",
        "细颗粒",
        "微细颗粒物",
        "细颗粒物浓度"
      ],
      "definition": "空气中直径小于 2.5 微米的细颗粒：约为头发丝宽度的三十分之一，小到足以深入肺部。以每立方米空气中的微克数计量；越低越好。"
    },
    "dew point": {
      "term": "露点",
      "aliases": [
        "露点",
        "露点温度",
        "结露点",
        "露点值"
      ],
      "definition": "空气需要冷却到多少度才会开始结露的温度。它是衡量湿度的诚实指标：10 °C 以下感觉干燥，16 至 18 °C 潮湿，18 至 21 °C 闷热，21 °C 以上则令人难以忍受。"
    },
    "muggy": {
      "term": "闷热",
      "aliases": [
        "闷热",
        "闷热小时",
        "闷热时数",
        "闷湿",
        "潮闷",
        "闷热的小时",
        "湿闷"
      ],
      "definition": "露点达到或高于 18 °C 的小时：空气感觉黏腻，出汗也无法帮你降温。"
    },

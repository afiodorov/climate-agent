{
  "language": "简体中文",
  "thousands": ",",
  "terms": {
    "comfort hours": {
      "term": "舒适小时",
      "aliases": [
        "舒适小时",
        "舒适时数",
        "舒适时间",
        "舒适小时数",
        "舒适的小时",
        "舒适白昼时数"
      ],
      "definition": "典型年份中在户外既不太热也不太冷的白昼小时数：体感温度为 {cold_full:g} 至 {warm_full:g} °C，假设约有一半时间处于阳光下，并对下雨的小时打折扣。这是最主要的指标。"
    },
    "daylight hours": {
      "term": "白昼小时",
      "aliases": [
        "白昼小时",
        "白昼时数",
        "白天小时",
        "白天时数",
        "白昼时间",
        "日间时数"
      ],
      "definition": "一年中太阳位于地平线以上或处于民用曙暮光的小时数。只有这些小时才可能被算作舒适；夜间从不计分。"
    },
    "comfort fraction": {
      "term": "舒适比例",
      "aliases": [
        "舒适比例",
        "舒适占比",
        "舒适份额",
        "舒适率",
        "白昼舒适比例",
        "舒适时数占比"
      ],
      "definition": "白昼小时中舒适小时所占的比例。它对高纬度北方城市偏于宽容：那里难熬的时段是黑夜，而黑夜不属于白昼，因此从不计入对城市的不利。"
    },
    "comfort band": {
      "term": "舒适区间",
      "aliases": [
        "舒适区间",
        "舒适带",
        "舒适范围",
        "舒适温度区间",
        "舒适温度带",
        "基准区间",
        "基准舒适区间"
      ],
      "definition": "被算作舒适的体感温度范围。{cold_full:g} 至 {warm_full:g} °C 为满分，向两侧逐渐递减，在冷侧的 {cold_zero:g} °C 和暖侧的 {warm_zero:g} °C 降为零。"
    },
    "UTCI": {
      "term": "通用热气候指数",
      "aliases": [
        "通用热气候指数",
        "通用热舒适指数",
        "UTCI指数",
        "UTCI 指数",
        "通用热环境气候指数",
        "体感温度指数"
      ],
      "definition": "通用热气候指数（Universal Thermal Climate Index）：以 °C 表示的体感温度。它把气温、湿度、风和日照合并为一个数字，反映站在户外的人对天气的实际感受。"
    },
    "evenness factor": {
      "term": "均匀度因子",
      "aliases": [
        "均匀度因子",
        "均匀因子",
        "均匀度",
        "均匀性因子",
        "均衡因子",
        "均衡度",
        "均匀系数",
        "均匀度系数"
      ],
      "definition": "舒适小时在十二个月中分布得有多均匀，从 0（全部集中在一个季节）到 1（每月相同）。它等于 1 减去各月总量相对其平均值的变动幅度。"
    },
    "composite": {
      "term": "综合得分",
      "aliases": [
        "综合得分",
        "综合分数",
        "综合评分",
        "综合指数",
        "复合得分",
        "复合分数",
        "复合指数",
        "综合分"
      ],
      "definition": "排名所依据的唯一得分：舒适小时 × 均匀度因子 × 空气质量因子。因为是相乘，死寂的冬天或污浊的空气都会把城市拉下来，无论它有多少舒适小时。"
    },
    "worst month": {
      "term": "最差月份",
      "aliases": [
        "最差月份",
        "最差月",
        "最糟月份",
        "最坏月份",
        "最差的月份"
      ],
      "definition": "舒适小时最少的月份。"
    },
    "best month": {
      "term": "最佳月份",
